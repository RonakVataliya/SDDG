# Shared secret; the backend must send the same value (its INTERNAL_API_KEY). Required: without it every
# endpoint except /health answers 503. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
LLM_PROVIDER=groq
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=16384
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=8.0
REQUEST_TIMEOUT_SECONDS=60
EXTRACTION_TIMING_TARGET_SECONDS=60
ENVIRONMENT=development
LOG_LEVEL=INFO
KROKI_BASE_URL=http://localhost:8080
KROKI_ENGINE=plantuml
KROKI_TIMEOUT_SECONDS=90
