# Shared secret; the backend must send the same value (its INTERNAL_API_KEY). Required: without it every
# endpoint except /health answers 503. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
LLM_PROVIDER=groq
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=8192
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_OUTPUT_TOKENS=16384
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=8.0
REQUEST_TIMEOUT_SECONDS=60
EXTRACTION_TIMING_TARGET_SECONDS=60
ENVIRONMENT=development
LOG_LEVEL=INFO
KROKI_BASE_URL=http://localhost:8080
KROKI_ENGINE=plantuml
KROKI_TIMEOUT_SECONDS=90

# ---- LLM gateway (app/llm): provider order, limits, waiting. Limits are working values, ~80% of the provider's
# documented limit for your tier (0 = no limit). Groq free tier for openai/gpt-oss-120b (console.groq.com/docs/rate-limits,
# checked 2026-11-09): 30 RPM, 1K RPD, 8K TPM, 200K TPD. Gemini free-tier limits are shown per project in AI Studio
# (aistudio.google.com/rate-limit); set GEMINI_* from there.
LLM_PROVIDERS=groq,gemini
LLM_FAILOVER_WAIT_SECONDS=20
LLM_MAX_WAIT_SECONDS=120
LLM_SEED=7
GROQ_RPM=24
GROQ_TPM=6400
GROQ_RPD=800
GROQ_TPD=160000
GROQ_MAX_CONCURRENCY=2
GROQ_MAX_REQUEST_TOKENS=6000
GROQ_REASONING=
GROQ_EXTRACTION_MODE=per_node
GEMINI_RPM=8
GEMINI_TPM=200000
GEMINI_RPD=200
GEMINI_TPD=0
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_REQUEST_TOKENS=100000
GEMINI_REASONING=
GEMINI_EXTRACTION_MODE=per_node
