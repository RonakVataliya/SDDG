# Copy to .env.local. Leave the Supabase values empty to use the mock auth + MSW API (no backend needed).
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" = serve the API from MSW stubs in the browser. Set to "false" once BE's API is deployed (H3).
VITE_USE_MOCKS=false
# "true" = the first few mock requests answer 503, to demo the "Server is starting" banner (FR30c).
VITE_MOCK_COLD_START=false
