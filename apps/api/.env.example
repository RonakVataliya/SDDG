# Supabase dashboard > Connect > "Session pooler" (or "Transaction pooler") connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Local development: accepts the frontend's mock-token without Supabase Auth.
DEV_AUTH_BYPASS=true

# Real Supabase authentication (same URL / publishable key as the web app).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

AI_SERVICE_URL=http://127.0.0.1:8001/api/v1
AI_POLICY_VERSION=2026-09-01
KROKI_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173
